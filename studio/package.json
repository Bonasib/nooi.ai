{
  "name": "nooi-studio",
  "private": true,
  "version": "0.1.0",
  "description": "nooi Studio Editor — a timeline video editor for nooi.ai (web, desktop, mobile) and its render service",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build && pnpm --filter @nooi/studio-web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @nooi/studio-web dev",
    "dev:api": "pnpm --filter @nooi/render-api dev"
  }
}
