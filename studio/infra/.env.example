# nooi Studio render service — /opt/nooi-render/.env (deploy/render.sh writes it with a random database password).
# No AI provider keys here: the render service only runs FFmpeg. Accounts, credits and AI stay with the nooi.ai site.
PG_PASSWORD=change-me-to-a-long-random-string
# the nooi.ai site on this VPS, seen from the containers (its PORT from /opt/nooi/.env)
NOOI_APP_URL=http://host.docker.internal:8080
# renders at once on the CPU (each FFmpeg uses several cores): 1 on 2–4 vCPU, 2 on 8 vCPU
RENDER_CONCURRENCY=1
RENDER_KEEP_DAYS=7
RENDER_MAX_SECONDS=1800
MAX_UPLOAD_MB=4096
# uploaded media kept for this many days (0 = until deleted with the project's account)
UPLOAD_KEEP_DAYS=0
# by plan: renders waiting or running at once, and queue priority (lower goes first)
RENDER_PLAN_LIMITS={"free":1,"creator":1,"pro":2,"studio":3,"staff":4}
RENDER_PLAN_PRIORITY={"studio":1,"staff":1,"pro":3,"creator":5,"free":8}
# virus scan of every upload: start with  --profile scan  and set
CLAMAV_HOST=
CLAMAV_PORT=3310
