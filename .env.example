# ───────── Server ─────────
PORT=8080
# Public https address of this server (social platforms download media from here)
PUBLIC_BASE_URL=https://studio.example.com
# Copy provider results into /media so every platform can fetch them from your domain
MIRROR_MEDIA=true
# Path to ffmpeg (needed to chain chapters from the last frame)
FFMPEG_PATH=ffmpeg

# ───────── Sign-in (Firebase Auth: Google, Apple, email link, phone SMS) ─────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Service account JSON (one line) OR set GOOGLE_APPLICATION_CREDENTIALS to the file path
FIREBASE_SERVICE_ACCOUNT=

# ───────── AI providers (fill the ones you have) ─────────
# Video generation — WAN 3.0
# Kie AI (kie.ai) — one key for many platforms: Kling, Seedance, Wan, Hailuo/MiniMax, Veo, Grok, Nano Banana,
# GPT Image, Seedream, Flux, Suno… Can also be set in Admin → AI providers → Kie AI (stored encrypted).
# Default models are used when no direct provider is connected; ids are the ones on each model's kie.ai page.
KIE_API_KEY=
KIE_VIDEO_MODEL=
KIE_IMAGE_MODEL=
KIE_MUSIC_MODEL=
WAN_API_URL=
WAN_API_KEY=
WAN_MODEL=wan-3.0
# Images
IMAGE_API_URL=
IMAGE_API_KEY=
# Voice / TTS
TTS_API_URL=
TTS_API_KEY=
# Lip sync
LIPSYNC_API_URL=
LIPSYNC_API_KEY=
# Music & SFX
MUSIC_API_URL=
MUSIC_API_KEY=
# AI background removal (matting)
MATTING_API_URL=
MATTING_API_KEY=
# Motion capture
MOCAP_API_URL=
MOCAP_API_KEY=
# Upscale / interpolation / restore / reframe / extend
ENHANCE_API_URL=
ENHANCE_API_KEY=
# GPU features (SAM 3D, 3D body, render streaming) are off. Set true only when a GPU service is connected.
GPU_FEATURES=false
# Prompt-based video edit
EDIT_API_URL=
EDIT_API_KEY=
# Transcription / captions (speech-to-text with timestamps)
STT_API_URL=
STT_API_KEY=
# Dubbing (voice translation + optional lip sync)
DUB_API_URL=
DUB_API_KEY=
# Text AI: story writing, captions, subtitle translation, site analysis, UI translation
# Option A — Claude:
#   LLM_API_KEY=sk-ant-...        (LLM_BASE_URL empty, LLM_MODEL optional)
# Option B — Qwen trial (Anthropic-compatible endpoint):
#   LLM_BASE_URL=https://token-plan.maas.qwencloudapi.com/apps/anthropic
#   LLM_API_KEY=<your Qwen key>
#   LLM_MODEL=<model name exactly as shown in your Qwen console>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional smart routing: a cheap model for small tasks, the strongest for hard ones
LLM_MODEL_FAST=
LLM_MODEL_STRONG=

# ───────── Social publishing (OAuth apps) ─────────
OAUTH_REDIRECT_BASE=https://studio.example.com
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ───────── Payments (credits & plans) ─────────
# moyasar | tap | stripe  — test in sandbox before going live
PAYMENT_PROVIDER=moyasar
MOYASAR_SECRET_KEY=
TAP_SECRET_KEY=
STRIPE_SECRET_KEY=
FREE_CREDITS=100

# ───────── Live Sketch (realtime image model, e.g. an SDXL-Turbo / LCM / FLUX-schnell img2img endpoint) ─────────
REALTIME_API_URL=
REALTIME_API_KEY=

# ───────── Admin dashboard ─────────
# Owners (comma-separated emails). Invite other admins with roles from the dashboard.
ADMIN_EMAILS=
# Encrypts provider & payment keys saved from the dashboard (32+ random characters)
SECRET_KEY=
SUPPORT_INBOX=contact@nooi.ai

# ───────── More AI providers (or set them in the dashboard) ─────────
SEEDANCE_API_KEY=
SEEDANCE_MODEL=
MINIMAX_API_KEY=
MINIMAX_MODEL=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_VIDEO_MODEL=
DASHSCOPE_IMAGE_MODEL=

# ───────── More payments ─────────
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_ENV=demo

# ───────── Email (Resend or SendGrid) — sender contact@nooi.ai ─────────
# resend | sendgrid | smtp  (smtp = your Hostinger mailbox)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=nooi.ai <contact@nooi.ai>

# 3D world engine (World Labs Marble / HunyuanWorld hosting / custom)
WORLD_API_URL=
WORLD_API_KEY=
WORLD_ENGINE=

# ───────── v35 providers ─────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GOOGLE_API_KEY=
# Midjourney has no official public API; only set these for an authorised provider
MIDJOURNEY_API_KEY=
MIDJOURNEY_BASE_URL=

# OpenAI (GPT Image) — set the exact model id in Admin → Models
OPENAI_API_KEY=

# ───────── Hostinger email (when EMAIL_PROVIDER=smtp) ─────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@nooi.ai
SMTP_PASS=
